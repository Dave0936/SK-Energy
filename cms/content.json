   "_id": "post-heat-pump-winter",
   "_type": "post",
   "title": "What a heat pump actually costs to run in a Fife winter",
   "slug": {
    "current": "heat-pump-running-costs-fife-winter"
   },
   "category": "Guide",
   "readTime": 6,
   "publishedAt": "2026-10-14",
   "author": {
    "name": "Graeme Kerr",
    "role": "Lead heat pump engineer"
   },
   "excerpt": "Twelve months of metered data from four local installs, set against what the same houses paid for gas.",
   "mainImage": {
    "_type": "image",
    "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3GEBhpJDThOL4J5Wt3PW565Nnud/hf_20260911_171155_8249db3e-bf60-4ddb-9f04-bb386db30d90.png",
